{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dog-smart-learning-centre:schema:learning-centre.delivery.v1",
  "title": "Learning Centre brand delivery envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "destination",
    "cursor",
    "nextCursor",
    "items",
    "revocations"
  ],
  "properties": {
    "schemaVersion": { "const": "learning-centre.delivery.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "destination": { "$ref": "#/$defs/destination" },
    "cursor": { "type": ["string", "null"], "minLength": 1 },
    "nextCursor": { "type": ["string", "null"], "minLength": 1 },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/item" }
    },
    "revocations": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/revocation" }
    }
  },
  "$defs": {
    "brand": {
      "type": "string",
      "enum": ["dog_smart", "briarrose_gundogs"]
    },
    "destination": {
      "type": "string",
      "enum": ["learning_centre", "dog_smart_site", "briarrose_site"]
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "nullableUrl": {
      "type": ["string", "null"],
      "format": "uri",
      "pattern": "^https://"
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "displayName", "role", "profileUrl"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "role": { "type": ["string", "null"] },
        "profileUrl": { "$ref": "#/$defs/nullableUrl" }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryBrand",
        "eligibleBrands",
        "destinationBrand",
        "author",
        "cta"
      ],
      "properties": {
        "primaryBrand": { "$ref": "#/$defs/brand" },
        "eligibleBrands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/brand" }
        },
        "destinationBrand": {
          "anyOf": [{ "$ref": "#/$defs/brand" }, { "type": "null" }]
        },
        "author": { "$ref": "#/$defs/author" },
        "cta": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "href"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "href": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "label"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citationId", "label", "url", "evidenceType"],
      "properties": {
        "citationId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/nullableUrl" },
        "evidenceType": { "type": ["string", "null"] }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contentId",
        "versionId",
        "publicationRecordId",
        "revision",
        "publishedAt",
        "mode",
        "route",
        "canonical",
        "presentation",
        "title",
        "summary",
        "bodyMarkdown",
        "seo",
        "topics",
        "citations",
        "checksumSha256"
      ],
      "properties": {
        "kind": { "type": "string", "enum": ["article", "knowledge"] },
        "contentId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" },
        "publicationRecordId": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "mode": {
          "type": "string",
          "enum": ["canonical_full", "syndicated_full", "summary_link"]
        },
        "route": { "type": "string", "pattern": "^/(?!/)" },
        "canonical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ownerDestination", "url"],
          "properties": {
            "ownerDestination": { "$ref": "#/$defs/destination" },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        },
        "presentation": { "$ref": "#/$defs/presentation" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "bodyMarkdown": { "type": ["string", "null"] },
        "seo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "imageUrl"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "imageUrl": { "$ref": "#/$defs/nullableUrl" }
          }
        },
        "topics": {
          "type": "array",
          "items": { "$ref": "#/$defs/topic" }
        },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        },
        "checksumSha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentId",
        "versionId",
        "publicationRecordId",
        "destination",
        "revokedAt",
        "revision"
      ],
      "properties": {
        "contentId": { "$ref": "#/$defs/uuid" },
        "versionId": { "$ref": "#/$defs/uuid" },
        "publicationRecordId": { "$ref": "#/$defs/uuid" },
        "destination": { "$ref": "#/$defs/destination" },
        "revokedAt": { "type": "string", "format": "date-time" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
